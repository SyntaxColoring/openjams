{
  "name": "openjams",
  "version": "0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "generate-types": "wrangler types --include-runtime false && prettier --write worker-configuration.d.ts",
    "check": "npm run check-types && npm run check-lint && npm run check-format",
    "check-lint": "eslint --max-warnings 0",
    "check-types": "tsc",
    "check-format": "prettier . --check",
    "fix-format": "prettier . --write"
  },
  "dependencies": {
    "@vis.gl/react-google-maps": "^1.10.2",
    "node-ical": "^0.27.6",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-server-dom-webpack": "19.2.9",
    "rwsdk": "1.7.5",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "5.20261117.1",
    "@eslint-react/eslint-plugin": "^5.30.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "~8.2.0",
    "wrangler": "4.164.0"
  },
  "overrides": {
    "rwsdk": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  },
  "allowScripts": {
    "workerd@1.20261117.1": true,
    "esbuild@0.28.2": true
  }
}
